# Discord Bot Token (required)
DISCORD_TOKEN=your-bot-token-here

# Discord Application ID
DISCORD_APP_ID=your-app-id-here

# Guild ID for slash command registration (dev mode)
DISCORD_GUILD_ID=your-guild-id-here

# SQLite database path
DB_PATH=./db/gerald.sqlite

# LLM model path (for node-llama-cpp)
LLM_MODEL_PATH=./models/your-model.gguf

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ETH routing defaults
ETH_DEFAULT_PATHWAY=P3
ETH_ALARM_FLOOD_WINDOW_MS=600000
ETH_ALARM_FLOOD_THRESHOLD=10

# Voice mask override (craft | cass | bare)
# Leave blank for automatic context detection
VOICE_MASK_OVERRIDE=

# Ring compiler: comma-separated ring IDs to disable
RINGS_DISABLED=

# Reflex engine: comma-separated reflex IDs to disable
REFLEXES_DISABLED=
